fun is_prime(n: int) -> bool  {

	if n < 2 {
		return false;
	}

	if n == 2 {
		return true;
	}

	let d: int = 2;
	while d < n {
		 if n%d==0 {
			return false;
		}
		d = d + 1;
	}
	return true;
}

fun main() -> int {
    if is_prime(42) == false {
        return 0;
    } else {
        return 1;
    }
}
